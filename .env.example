# ECO-Tracking Unified Environment Variables Example
# Copy this file to .env and configure your values

# ===============================================
# Backend Configuration
# ===============================================

# Server
NODE_ENV=development
PORT=3001
JWT_SECRET=your_super_secure_jwt_secret_key_here_min_256_bits

# ===============================================
# Azure Configuration
# ===============================================

# Azure Cosmos DB
COSMOS_DB_ENDPOINT=https://your-cosmosdb-account.documents.azure.com:443/
COSMOS_DB_KEY=your_cosmos_db_primary_key_here
COSMOS_DB_DATABASE_NAME=eco-tracking
COSMOS_DB_CONTAINER_USERS=users
COSMOS_DB_CONTAINER_RECORDS=recycling-records

# Azure Custom Vision
CUSTOM_VISION_ENDPOINT=https://your-region.cognitiveservices.azure.com/
CUSTOM_VISION_PREDICTION_KEY=your_custom_vision_prediction_key
CUSTOM_VISION_PROJECT_ID=your_custom_vision_project_id
CUSTOM_VISION_ITERATION_NAME=Iteration1
CUSTOM_VISION_RESOURCE_ID=/subscriptions/your-subscription-id/resourceGroups/your-rg/providers/Microsoft.CognitiveServices/accounts/your-cv-resource

# Azure Blob Storage (for image uploads)
AZURE_STORAGE_ACCOUNT_NAME=your_storage_account_name
AZURE_STORAGE_ACCOUNT_KEY=your_storage_account_key
AZURE_STORAGE_CONTAINER_NAME=eco-tracking-images

# Azure Maps
AZURE_MAPS_SUBSCRIPTION_KEY=your_azure_maps_subscription_key

# ===============================================
# Enhanced Features (Optional)
# ===============================================

# TensorFlow Serving (for enhanced AI models)
TENSORFLOW_SERVING_URL=http://localhost:8501/v1/models/waste_classifier:predict

# Redis (for caching and session management)
REDIS_CONNECTION_STRING=redis://localhost:6379
REDIS_PASSWORD=your_redis_password

# Email Service (for notifications)
SENDGRID_API_KEY=your_sendgrid_api_key
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your_sendgrid_api_key

# ===============================================
# Security & Rate Limiting
# ===============================================

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,https://yourdomain.com

# ===============================================
# Monitoring & Analytics
# ===============================================

# Application Insights (Azure)
APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=your-key;IngestionEndpoint=https://your-region.in.applicationinsights.azure.com/;LiveEndpoint=https://your-region.livediagnostics.monitor.azure.com/

# Sentry (Error Tracking)
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# ===============================================
# Frontend Configuration (create frontend/.env.local)
# ===============================================

# API Configuration
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# Azure Maps (Public)
NEXT_PUBLIC_AZURE_MAPS_KEY=your_azure_maps_subscription_key

# Mapbox (Optional, alternative to Azure Maps)
NEXT_PUBLIC_MAPBOX_TOKEN=your_mapbox_access_token

# PWA Features
NEXT_PUBLIC_ENABLE_OFFLINE=true
NEXT_PUBLIC_PWA_ENABLED=true
NEXT_PUBLIC_ENABLE_NOTIFICATIONS=true
NEXT_PUBLIC_ENABLE_CAMERA=true

# Analytics
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=GA_MEASUREMENT_ID
NEXT_PUBLIC_MICROSOFT_CLARITY_ID=your_clarity_project_id

# ===============================================
# AI Model Configuration (create ai-model/config.yaml)
# ===============================================

# Training Configuration
MODEL_TRAINING_EPOCHS=50
MODEL_BATCH_SIZE=32
MODEL_LEARNING_RATE=0.001
MODEL_VALIDATION_SPLIT=0.2

# Dataset Configuration  
DATASET_PATH=/path/to/your/dataset
DATASET_AUGMENTATION=true
DATASET_NORMALIZE=true

# Model Serving
MODEL_SERVING_HOST=0.0.0.0
MODEL_SERVING_PORT=8501
MODEL_VERSION=1

# ===============================================
# Development & Testing
# ===============================================

# Test Database (use separate Cosmos DB for testing)
TEST_COSMOS_DB_ENDPOINT=https://your-test-cosmosdb.documents.azure.com:443/
TEST_COSMOS_DB_KEY=your_test_cosmos_db_key

# Mock Services (for development without Azure)
USE_MOCK_CUSTOM_VISION=false
USE_MOCK_AZURE_MAPS=false
USE_MOCK_COSMOS_DB=false

# Logging
LOG_LEVEL=info
LOG_FORMAT=combined
ENABLE_REQUEST_LOGGING=true

# ===============================================
# Production Deployment
# ===============================================

# Health Check
HEALTH_CHECK_ENDPOINT=/health
HEALTH_CHECK_INTERVAL=30000

# SSL/HTTPS
SSL_CERT_PATH=/path/to/ssl/certificate.crt
SSL_KEY_PATH=/path/to/ssl/private.key

# CDN (for static assets)
CDN_URL=https://your-cdn-domain.com

# Load Balancer
BEHIND_PROXY=true
PROXY_TRUST=true