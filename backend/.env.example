# Environment Configuration
NODE_ENV=development
PORT=3001

# Frontend Configuration
FRONTEND_URL=http://localhost:3000

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# Azure Cosmos DB Configuration
COSMOS_DB_ENDPOINT=https://your-cosmosdb-account.documents.azure.com:443/
COSMOS_DB_KEY=your_cosmos_db_primary_key
COSMOS_DB_DATABASE_NAME=eco-tracking
COSMOS_DB_USERS_CONTAINER=users
COSMOS_DB_RECYCLING_CONTAINER=recycling-records
COSMOS_DB_CENTERS_CONTAINER=recycling-centers

# Azure Blob Storage Configuration
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=your_account;AccountKey=your_key;EndpointSuffix=core.windows.net
AZURE_STORAGE_CONTAINER_NAME=waste-images

# Azure Custom Vision Configuration
CUSTOM_VISION_TRAINING_KEY=your_custom_vision_training_key
CUSTOM_VISION_PREDICTION_KEY=your_custom_vision_prediction_key
CUSTOM_VISION_ENDPOINT=https://your-region.cognitiveservices.azure.com/
CUSTOM_VISION_PROJECT_ID=your_project_id
CUSTOM_VISION_ITERATION_NAME=your_iteration_name

# Azure AD B2C Configuration
AZURE_CLIENT_ID=your_azure_ad_b2c_client_id
AZURE_CLIENT_SECRET=your_azure_ad_b2c_client_secret
AZURE_TENANT_ID=your_azure_ad_b2c_tenant_id
AZURE_AUTHORITY=https://your_tenant.b2clogin.com/your_tenant.onmicrosoft.com/B2C_1_signupsignin

# Azure Maps Configuration
AZURE_MAPS_SUBSCRIPTION_KEY=your_azure_maps_subscription_key

# Application Settings
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp
CLASSIFICATION_CONFIDENCE_THRESHOLD=0.7